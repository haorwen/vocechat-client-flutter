platform :ios, '12.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  settings = File.expand_path('Flutter/Generated.xcconfig', __dir__)
  raise "#{settings} must exist; run flutter pub get first" unless File.exist?(settings)

  File.foreach(settings) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT not found in #{settings}"
end

require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods __dir__
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end

# AgoraRtcEngine_Special_iOS 4.5.3.70 already weak-links its optional
# extensions. Trim after CocoaPods has embedded them, before app code signing.
# post_integrate runs after CocoaPods adds its embed phase to Runner.
post_integrate do |installer|
  installer.aggregate_targets.map(&:user_project).uniq.each do |project|
    runner = project.targets.find { |target| target.name == 'Runner' }
    next unless runner

    phase_name = 'Trim unused Agora frameworks'
    phase = runner.shell_script_build_phases.find { |item| item.name == phase_name }
    phase ||= runner.new_shell_script_build_phase(phase_name)
    phase.shell_path = '/bin/sh'
    phase.shell_script = 'set -eu' + "\n" +
      'python3 "$SRCROOT/scripts/trim_agora_frameworks.py" "$TARGET_BUILD_DIR/$WRAPPER_NAME" --trim'
    phase.always_out_of_date = '1'
    runner.build_phases.delete(phase)
    runner.build_phases << phase
    project.save
  end
end
